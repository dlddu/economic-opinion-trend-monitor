# The scheduled ingestion CronWorkflow (AC1.1, deploy/batch/) runs this image; the
# data lake is provided at runtime by mounting it at ECON_DATA_ROOT.
# Single stage on the uv image on purpose: `uv sync` bakes absolute interpreter
# paths into the venv's console scripts, so copying .venv into a second stage
# would depend on reproducing that exact path. The batch runs on a schedule,
# not per request, so image size is not the binding constraint here.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app
COPY python/ ./

# --frozen: fail rather than silently resolve if uv.lock is out of date.
# --no-dev: pytest/ruff are CI concerns, not runtime ones.
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH" \
    ECON_DATA_ROOT=/data \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["econ-ingestion"]
