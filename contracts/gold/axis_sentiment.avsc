{
  "type": "record",
  "name": "AxisSentiment",
  "namespace": "econ.gold",
  "doc": "Gold record — per (axis, time bucket) sentiment distribution (AC3.4, AC3.6).",
  "x-layer": "gold",
  "fields": [
    {
      "name": "axis",
      "type": { "type": "enum", "name": "Axis", "symbols": ["KR", "US", "GLOBAL"] },
      "doc": "Source axis (AC3.4)."
    },
    {
      "name": "bucket_unit",
      "type": { "type": "enum", "name": "BucketUnit", "symbols": ["hour", "day", "week"] },
      "doc": "Time bucket unit (AC3.3)."
    },
    {
      "name": "time_bucket",
      "type": "string",
      "doc": "Bucket label (AC3.3)."
    },
    {
      "name": "distribution",
      "type": {
        "type": "record",
        "name": "SentimentDistribution",
        "doc": "Sentiment ratios for analyzed items; unanalyzed kept separate (AC3.4, AC3.6).",
        "fields": [
          { "name": "positive", "type": "double" },
          { "name": "neutral", "type": "double" },
          { "name": "negative", "type": "double" },
          { "name": "mixed", "type": "double" },
          {
            "name": "unanalyzed",
            "type": "double",
            "doc": "Share separated out from the sentiment ratios (AC2.5, AC3.4)."
          }
        ]
      },
      "doc": "Sentiment distribution for this axis/bucket."
    },
    {
      "name": "analyzed_total",
      "type": "long",
      "doc": "Count of analyzed items contributing to the distribution."
    }
  ]
}
