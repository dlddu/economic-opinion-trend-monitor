{
  "type": "record",
  "name": "SubjectTrend",
  "namespace": "econ.gold",
  "doc": "Gold record — per (subject, axis, time bucket) trend aggregation (AC6.1-AC5.2, AC5.4, AC6.2).",
  "x-layer": "gold",
  "fields": [
    {
      "name": "subject",
      "type": "string",
      "doc": "Narrative subject key; variants are unified to one key (AC5.1)."
    },
    {
      "name": "axis",
      "type": { "type": "enum", "name": "Axis", "symbols": ["KR", "US", "GLOBAL"] },
      "doc": "Source axis (AC5.3, AC5.6)."
    },
    {
      "name": "bucket_unit",
      "type": { "type": "enum", "name": "BucketUnit", "symbols": ["hour", "day", "week"] },
      "doc": "Time bucket unit; hour rolls up to day/week (AC5.2)."
    },
    {
      "name": "time_bucket",
      "type": "string",
      "doc": "Bucket label, e.g. 2026-06-23T14 (AC5.2)."
    },
    {
      "name": "raw_count",
      "type": "long",
      "doc": "Raw collected count before normalization, shown alongside the share (AC6.2)."
    },
    {
      "name": "normalized_share",
      "type": "double",
      "doc": "Source-deviation-normalized interest share (AC6.1, AC6.2)."
    },
    {
      "name": "delta",
      "type": "double",
      "doc": "Change vs the previous bucket, in percentage points (AC5.4)."
    },
    {
      "name": "spark",
      "type": { "type": "array", "items": "double" },
      "doc": "Recent share values for the sparkline (AC5.4)."
    }
  ]
}
